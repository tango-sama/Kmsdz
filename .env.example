# ------------------------------------------------------------------
# KMS website - environment variables (copy to .env.local, never commit)
# ------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.kms-dz.com

# --- Google Sheets (server-side only) -----------------------------
# ID is the long string in the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key from the service-account JSON. Keep the \n sequences
# (or paste real line breaks inside double quotes).
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_NAME=

# --- File attachments (optional) ----------------------------------
# Vercel Blob read/write token. Without it, files are NOT stored; the visitor
# is told to send them by WhatsApp or email instead.
BLOB_READ_WRITE_TOKEN=

# --- Anti-spam (optional but recommended) -------------------------
# Cloudflare Turnstile (free). Leave empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Contact / business details that may change -------------------
# WhatsApp number in international format without "+" (default: 213661204590)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Google Maps embed URL (src of the "Embed a map" iframe). Leave empty for placeholder.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
